From 471f9dc605758f1e0c6ee7b9d6522406b1c496f9 Mon Sep 17 00:00:00 2001
From: Mikhail Anikin <mikhail.anikin@solid-run.com>
Date: Mon, 10 Feb 2025 09:23:55 +0000
Subject: [PATCH] Enable SOM rev 1.0 and 1.1 cosupport for a single u-boot
 image

---
 arch/arm/dts/hailo15-solidrun.dts             | 104 +++++++++++-------
 .../hailo/hailo15-solidrun/hailo15_solidrun.c |  57 +++++++---
 configs/hailo15_solidrun_defconfig            |   1 +
 3 files changed, 104 insertions(+), 58 deletions(-)

diff --git a/arch/arm/dts/hailo15-solidrun.dts b/arch/arm/dts/hailo15-solidrun.dts
index e1a695b077..b35eb9cd4f 100644
--- a/arch/arm/dts/hailo15-solidrun.dts
+++ b/arch/arm/dts/hailo15-solidrun.dts
@@ -19,15 +19,9 @@
 	};
 };
 
-
-// &hailo_boot_info {
-//     uart-0-reverse-rts;
-//     uart-0-reverse-cts;
-// };
-
 &gpio0 {
     pinctrl-names = "default";
-    pinctrl-0 = <&pinctrl_gpio1>;
+    pinctrl-0 = <&pinctrl_gpio1>, <&pinctrl_gpio8>, <&pinctrl_gpio14>;
     u-boot,dm-pre-reloc;
     u-boot,dm-spl;
 
@@ -39,6 +33,24 @@
         u-boot,dm-spl;
         u-boot,dm-pre-reloc;
     };
+
+    pca953x_reset_v1: pca953x_reset_v1 {
+		gpio-hog;
+		gpios = <8 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "pca953x_reset_v1";
+        u-boot,dm-spl;
+        u-boot,dm-pre-reloc;
+    };
+
+    pca953x_reset: pca953x_reset {
+		gpio-hog;
+		gpios = <14 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "pca953x_reset";
+        u-boot,dm-spl;
+        u-boot,dm-pre-reloc;
+    };
 };
 
 /* SDIO0 should be enabled in u-boot in order to work in Linux  */
@@ -106,6 +118,16 @@
         function = "gpio";
         groups = "gpio1_grp";
     };
+
+    pinctrl_gpio8: gpio8 {
+        function = "gpio";
+        groups = "gpio8_grp";
+    };
+
+    pinctrl_gpio14: gpio14 {
+        function = "gpio";
+        groups = "gpio14_grp";
+    };
 };
 
 &i2c_0 {
@@ -116,40 +138,40 @@
 		reg = <0x50>;
 	};
 
-    // pca9539: pca9539@74 {
-	// 	compatible = "nxp,pca9539";
-	// 	reg = <0x74>;
-	// 	gpio-controller;
-	// 	#gpio-cells = <2>;
-    //     reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
-    //     gpio-line-names =
-    //     "pca_0_WL_REG_ON",
-    //     "pca_1_BT_REG_ON",
-    //     "pca_2_ETH_RST",
-    //     "pca_3_ENET_nINT",
-    //     "pca_4",
-    //     "pca_8_H_PCIE_PERST_N",
-    //     "pca_9_H_PCIE_CLKREQ_N",
-    //     "pca_10_H_PCIE_WAKE_N",
-    //     "pca_11_PCIE_nCLK_N",
-    //     "pca_12",
-    //     "pca_13",
-    //     "pca_14",
-    //     "pca_15";
-
-    //     WIFI_HOG {
-	// 		gpio-hog;
-	// 		gpios = <0 GPIO_ACTIVE_HIGH>;
-	// 		output-low;
-	// 		line-name = "WL_REG_ON";
-	// 	};
-    //     BT_HOG {
-	// 		gpio-hog;
-	// 		gpios = <1 GPIO_ACTIVE_HIGH>;
-	// 		output-low;
-	// 		line-name = "WL_REG_ON";
-	// 	};
-    // };
+    pca9539: pca9539@74 {
+		compatible = "nxp,pca9539";
+		reg = <0x74>;
+		gpio-controller;
+		#gpio-cells = <2>;
+
+        gpio-line-names =
+        "pca_0_WL_REG_ON",
+        "pca_1_BT_REG_ON",
+        "pca_2_ETH_RST",
+        "pca_3_ENET_nINT",
+        "pca_4",
+        "pca_8_H_PCIE_PERST_N",
+        "pca_9_H_PCIE_CLKREQ_N",
+        "pca_10_H_PCIE_WAKE_N",
+        "pca_11_PCIE_nCLK_N",
+        "pca_12",
+        "pca_13",
+        "pca_14",
+        "pca_15";
+
+        WIFI_HOG {
+			gpio-hog;
+			gpios = <0 GPIO_ACTIVE_HIGH>;
+			output-low;
+			line-name = "WL_REG_ON";
+		};
+        BT_HOG {
+			gpio-hog;
+			gpios = <1 GPIO_ACTIVE_HIGH>;
+			output-low;
+			line-name = "WL_REG_ON";
+		};
+    };
 };
 
 &i2c_2 {
diff --git a/board/hailo/hailo15-solidrun/hailo15_solidrun.c b/board/hailo/hailo15-solidrun/hailo15_solidrun.c
index 8fd5c700e2..eb760ca9e9 100644
--- a/board/hailo/hailo15-solidrun/hailo15_solidrun.c
+++ b/board/hailo/hailo15-solidrun/hailo15_solidrun.c
@@ -4,13 +4,13 @@
 #include <linux/err.h>
 #include <tlv_eeprom.h>
 
-
-#define CARRIER_SKU_MAX_SIZE 25
+// SKU example: SRHA15HWB1D04GE064V10|0/0
+#define CARRIER_SKU_MAX_SIZE 30
 #define FIT_CONF_ENV "fit_image_conf"
 
 /* '#' in the beginning of the configuration name is a part of bootm syntax */
-#define FIT_CONF_HB_IIOT "#conf-hailo_hailo15-solidrun.dtb" // default
-#define FIT_CONF_HB_PRO "#conf-hailo_hailo15-solidrun-hb-pro.dtb"
+#define FIT_CONF "#conf-hailo_hailo15-solidrun.dtb" // default
+#define FIT_CONF_SOM_REV1 FIT_CONF"#conf-hailo_hailo15-sr-som-v1-overlay.dtbo"
 
 enum carrier_boards
 {
@@ -115,9 +115,38 @@ int get_carrier(void)
 	return board;
 }
 
+int get_som_rev(void)
+{
+	int ret = 0;
+	int rev = 11;
+	struct udevice *dev;
+	char sku[CARRIER_SKU_MAX_SIZE];
+
+	ret = get_tlv_udevice_by_alias(&dev, "eeprom_som");
+	if (ret)
+		return rev;
+
+	ret = get_sku_from_tlv_dev(dev, sku);
+	if (ret)
+		return rev;
+	
+	switch (sku[20]) {
+	case '0':
+		rev = 10; // rev 1.0
+		break;
+	case '1':
+		rev = 11; // rev 1.1
+		break;
+	default: 
+		rev = 11;
+		break;
+	}
+	return rev;
+}
+
 void set_fit_image_configurations(void)
 {
-    int carrier;
+    int som_rev;
     char *fit_conf = env_get(FIT_CONF_ENV);
     if (fit_conf != NULL)
     {
@@ -125,21 +154,15 @@ void set_fit_image_configurations(void)
         return;
     }
 
-    carrier = get_carrier();
-    printf("Selecting fdt file for board %d...\n", carrier);
-	switch (carrier)
+    som_rev = get_som_rev();
+	switch (som_rev)
 	{
-	case CARRIER_HB_MATE:
-	case CARRIER_HB_RIPPLE:
-	case CARRIER_HB_PULSE:
-	case CARRIER_HB_PRO:
-		env_set(FIT_CONF_ENV, FIT_CONF_HB_PRO);
-		break;
-	case CARRIER_HB_IIOT:
-		env_set(FIT_CONF_ENV, FIT_CONF_HB_IIOT);
+	case 10:
+		printf("Selecting fdt file for the SOM rev 1.0 \n");
+		env_set(FIT_CONF_ENV, FIT_CONF_SOM_REV1);
 		break;
 	default:
-		pr_warn("Leaving default fit configuration \n");
+		pr_info("Leaving default fit configuration for som rev 1.1 \n");
 		break;
     }
 }
diff --git a/configs/hailo15_solidrun_defconfig b/configs/hailo15_solidrun_defconfig
index aebfe8f573..18c2a0974f 100644
--- a/configs/hailo15_solidrun_defconfig
+++ b/configs/hailo15_solidrun_defconfig
@@ -36,3 +36,4 @@ CONFIG_SPL_CMSDK_GPIO=y
 CONFIG_SPL_DM_GPIO=y
 CONFIG_SPL_DM_GPIO_LOOKUP_LABEL=y
 CONFIG_SPL_GPIO_HOG=y
+CONFIG_SPL_USE_TINY_PRINTF=y
\ No newline at end of file
-- 
2.47.1

